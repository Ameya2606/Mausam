# ============================================================
# VayuSync Frontend Environment Configuration
# Team: VayuSync
# ============================================================

# [LOCAL DEVELOPMENT]
# Default local FastAPI backend server:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Legacy aliases supported for backwards compatibility:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1

# [PRODUCTION DEPLOYMENT (Netlify)]
# Configure in Netlify Site Configuration -> Environment Variables:
# Variable name: NEXT_PUBLIC_API_BASE_URL
# Example value: https://vayusync-backend.onrender.com (or your public backend URL)
# IMPORTANT: Next.js injects NEXT_PUBLIC_* variables at BUILD TIME.
# After adding or changing this in Netlify, trigger a site redeploy ("Clear cache and deploy site").

