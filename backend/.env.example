# ============================================================
# VayuSync FastAPI Backend Environment Configuration
# Problem Statement ID: 26076 | Team: VayuSync
# ============================================================

# Network & Host
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Allowed Origins (comma-separated list of frontends)
# Local origins (localhost/127.0.0.1:3000) are always allowed.
# In production, add your deployed Netlify domain:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://vayusync.netlify.app

# Weather Provider Settings
WEATHER_PROVIDER=open_meteo

# Database URL (SQLite default for zero-setup, PostgreSQL compatible)
DATABASE_URL=sqlite:///./vayusync.db

# AI Assistant Settings (Optional - fallback rule engine active by default)
USE_MOCK_LLM=true
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
