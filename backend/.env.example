# Port for the FastAPI server
PORT=8000
HOST=0.0.0.0

# Frontend URL for strict CORS restriction
# Allow localhost/127.0.0.1 for local development
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Example Production Value
# FRONTEND_URL=https://mausam-1-8x84.onrender.com

# External API Configuration
WEATHER_PROVIDER=mock
IMD_API_BASE_URL=https://mausam.imd.gov.in/api/v1
IMD_API_KEY=your_imd_api_key_here

# LLM Configuration
USE_MOCK_LLM=true
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (defaults to sqlite)
DATABASE_URL=sqlite:///./vayusync.db

# Points & Leaderboard Configuration
POINTS_PER_VALID_FEEDBACK=10
